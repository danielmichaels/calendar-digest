package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			// Nothing here is public. Detail-page URLs in particular are protected
			// only by being unguessable, and they travel through message history.
			<meta name="robots" content="noindex, nofollow"/>
			// Declared together with the background below. A page that uses
			// dark: variants for text but leaves the surface to the browser
			// renders near-white on white for everyone whose OS is in dark mode
			// — correct markup, unreadable page, and no test can see it.
			<meta name="color-scheme" content="light dark"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/main.css"/>
<script type="module" src="/static/js/datastar.js"></script>
		</head>
		<body class="bg-white text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
