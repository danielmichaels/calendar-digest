package templates

// Digest is the page a notification links to. It is read on a phone, in the
// evening, to answer "what is on tomorrow and what do I need for it" — so the
// day leads, then each event's time, then how to get to it, then who else is
// coming.
templ Digest(v DigestView) {
	@Layout(v.Title) {
		<article class="mx-auto max-w-2xl px-5 py-10 sm:py-14">
			<header class="border-b border-neutral-200 pb-5 dark:border-neutral-800">
				<h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
					{ v.Date }
				</h1>
				<p class="mt-1.5 text-sm text-neutral-500 dark:text-neutral-400">
					{ v.RecipientName } &middot; { v.Zone }
				</p>
			</header>
			if len(v.Events) == 0 {
				<p class="py-10 text-neutral-500 dark:text-neutral-400">Nothing on.</p>
			} else {
				<ol class="divide-y divide-neutral-200 dark:divide-neutral-800">
					for _, ev := range v.Events {
						@digestEvent(ev)
					}
				</ol>
			}
			if v.CapturedAt != "" {
				<footer class="mt-8 border-t border-neutral-200 pt-5 text-xs leading-relaxed text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">
					Captured { v.CapturedAt }. This is what the calendar said at the
					time; it may have changed since.
				</footer>
			}
		</article>
	}
}

templ digestEvent(ev EventView) {
	<li class="py-6 sm:grid sm:grid-cols-[7.5rem_1fr] sm:gap-x-6">
		<p class="text-sm font-medium tabular-nums text-neutral-500 dark:text-neutral-400">
			{ ev.Time }
		</p>
		<div class="mt-1 sm:mt-0">
			<h2 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">
				{ ev.Summary }
				if ev.Tentative {
					<span class="ml-1.5 align-middle text-xs font-normal text-amber-700 dark:text-amber-500">tentative</span>
				}
				if ev.Recurring {
					<span class="ml-1.5 align-middle text-xs font-normal text-neutral-500 dark:text-neutral-400">repeats</span>
				}
			</h2>
			if ev.Location != "" {
				<p class="mt-1 text-neutral-700 dark:text-neutral-300">{ ev.Location }</p>
			}
			if ev.ConferenceURL != "" {
				<p class="mt-2.5">
					<a
						href={ templ.URL(ev.ConferenceURL) }
						class="inline-block rounded-md bg-neutral-900 px-3 py-1.5 text-sm font-medium text-white dark:bg-neutral-100 dark:text-neutral-900"
					>Join meeting</a>
				</p>
			}
			if ev.Description != "" {
				// Rendered as text, never markup: Google permits HTML here and
				// this is somebody else's calendar.
				<p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
					{ ev.Description }
				</p>
			}
			if len(ev.Attendees) > 0 {
				<ul class="mt-3 space-y-0.5 text-sm text-neutral-600 dark:text-neutral-400">
					for _, a := range ev.Attendees {
						<li>
							{ a.Name }
							if a.Response != "" {
								<span class="text-neutral-400 dark:text-neutral-500">&mdash; { a.Response }</span>
							}
							if a.Optional {
								<span class="text-neutral-400 dark:text-neutral-500">(optional)</span>
							}
						</li>
					}
				</ul>
			}
			if ev.Organizer != "" {
				<p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
					Organiser: { ev.Organizer }
				</p>
			}
			if ev.CalendarURL != "" {
				<p class="mt-2">
					<a
						href={ templ.URL(ev.CalendarURL) }
						class="text-sm text-neutral-500 underline underline-offset-2 dark:text-neutral-400"
					>Open in Google Calendar</a>
				</p>
			}
		</div>
	</li>
}
