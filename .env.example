#----------------------------------------
# App
#----------------------------------------
CGO_ENABLED=0
# Set to "production" in a deployment: it turns the development-friendly
# defaults below into hard startup errors.
APP_ENV=development

#----------------------------------------
# Server
#----------------------------------------
SERVER_PORT=9898
SERVER_TIMEOUT_READ=5s
SERVER_TIMEOUT_WRITE=10s
SERVER_TIMEOUT_IDLE=15s
X_API_KEY=changeme

#----------------------------------------
# Logging
#----------------------------------------
LOG_LEVEL=debug
LOG_JSON=false
LOG_CONCISE=false
LOG_REQUEST_HEADERS=true
LOG_RESPONSE_HEADERS=false

#----------------------------------------
# Rate Limiter
#----------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BACKOFF=20s

#----------------------------------------
# SQLite
#----------------------------------------
DATABASE_URL=database/data.db
DATABASE_CONNECTION_CONTEXT=15s

#----------------------------------------
# Litestream
#----------------------------------------
LITESTREAM_LOCAL_DB_PATH=./database/data.db
DB_SYNC_INTERVAL=10s
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_DB_URL=s3://

#----------------------------------------
# Sessions and CSRF
#----------------------------------------
SESSION_LIFETIME=168h
# Must be true anywhere the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Comma-separated scheme://host list of cross-origin sites allowed to submit
# to this app. Same-origin requests never need listing. Required in production.
TRUSTED_ORIGINS=

#----------------------------------------
# Background jobs
#----------------------------------------
# Serve the job dashboard from this binary. It can cancel and retry jobs and
# nothing authorises it yet, so leave it off until the mount site in
# internal/server/routes.go is behind this app's admin check.
RIVER_UI_EMBEDDED=false
# Where it mounts. Must not overlap /app, /static or the API paths.
RIVER_UI_PATH=/riverui
# How often the due check asks what digests are owed. This bounds how late a
# digest can be and how quickly recovery starts after an outage — not how
# often anything is sent.
TICK_INTERVAL=5m

#----------------------------------------
# Detail pages
#----------------------------------------
# Scheme and host every /d/{token} link is built from, no trailing slash.
# Unset is warned about at boot rather than fatal, and digests then go out
# with no link at all — which is honest, where a link nothing can follow is
# not. A value that is not an absolute http(s) URL is a startup error.
BASE_URL=

#----------------------------------------
# Google Calendar
#----------------------------------------
# The service account key, as JSON on one line. Never put this in the
# database: SQLite replicates to R2, and a key in a backup is a key in an
# object store. Left empty the app still boots, alerts that it cannot read
# anything, and captures no digests.
GOOGLE_SERVICE_ACCOUNT_JSON=

#----------------------------------------
# Telegram
#----------------------------------------
# The bot both digests and operator alerts go out through.
TELEGRAM_BOT_TOKEN=
# Chat that receives operator alerts — a refused Google credential above all.
# Deliberately separate from any recipient's target: whoever has to go and fix
# the Google console must hear about it even if no recipient uses Telegram.
# Unset means alerts only reach the log.
ALERT_TELEGRAM_CHAT_ID=

#----------------------------------------
# Email (SMTP)
#----------------------------------------
# The relay digests go out through. Unset leaves the email channel
# unconfigured: the app still boots and email targets fail their send loudly
# rather than being silently dropped.
SMTP_HOST=
SMTP_PORT=587
# Leave both empty for a relay that accepts unauthenticated mail from inside
# the network. TLS is opportunistic either way: STARTTLS when the relay offers
# it, plaintext when it does not.
SMTP_USERNAME=
SMTP_PASSWORD=
# The From address on every digest.
EMAIL_FROM=
